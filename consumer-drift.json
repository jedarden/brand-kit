  "out_of_scope": [
    {
      "platform": "Instagram",
      "surfaces": ["profile picture"],
      "reason": "The public profile does not expose a stable unauthenticated media URL; Instagram CDN URLs and page markup are session- and cache-dependent."
    },
    {
      "platform": "Threads",
      "surfaces": ["profile picture"],
      "reason": "The public profile does not expose a stable unauthenticated media URL that can be audited without a platform API credential."
    },
    {
      "platform": "Facebook",
      "surfaces": ["profile picture", "cover"],
      "reason": "No public account/page URL is registered, and Facebook cover media is delivered through dynamic or login-gated CDN responses."
    },
    {
      "platform": "YouTube",
      "surfaces": ["profile picture", "TV-safe banner"],
      "reason": "No stable channel URL is documented for this brand, and YouTube's public page is consent- or client-dependent rather than a stable media endpoint."
    },
    {
      "platform": "TikTok",
      "surfaces": ["profile picture"],
      "reason": "The public profile does not expose a stable unauthenticated media URL; profile media requires a supported API or dynamic page scraping."
    },
    {
      "platform": "Mastodon",
      "surfaces": ["profile picture", "banner"],
      "reason": "No Mastodon instance/account URL is documented, so there is no stable public endpoint from which to retrieve the hand-placed assets."
    },
    {
      "platform": "Bluesky",
      "surfaces": ["profile picture", "banner"],
      "reason": "No Bluesky handle is documented, and the public profile API returns instance-specific blob URLs rather than a configured stable consumer surface."
    },
    {
      "platform": "Discord",
      "surfaces": ["profile picture", "banner"],
      "reason": "Discord user profile media is not available from a stable unauthenticated public URL; retrieval requires an authenticated API or client session."
    },
    {
      "platform": "GitHub",
      "surfaces": ["repository social preview banner"],
      "reason": "The README asset is a manually configured repository social-preview upload, but GitHub does not expose a stable public URL for comparing that upload to the source file."
    }
  ]
}
