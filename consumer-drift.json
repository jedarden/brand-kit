    "mirror_repository": "https://github.com/jedarden/brand-kit.git",
    "tag_pattern": "^v\\d+\\.\\d+\\.\\d+$",
    "minimum_age_hours": 24,
    "require_checkout": true
  },
  "site": {
    "name": "jedarden.com",
    "checkout": "~/jedarden.com",
    "repository": "https://github.com/jedarden/jedarden.com.git",
    "branch": "main"
  },
  "live": {
