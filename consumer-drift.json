      "consumer": "x.com/jedardencodes",
      "source": "avatars/x-400.png",
      "url": "https://x.com/jedardencodes",
      "media_url_pattern": "https://pbs\\.twimg\\.com/profile_images/[^\\\"'\\\\ ]+_400x400\\.jpg",
