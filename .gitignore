# NEEDLE execution traces are local diagnostics.
**/.beads/traces/

# NEEDLE dispatch bookkeeping: HEAD SHA at worker dispatch time, local-only.
/.needle-predispatch-sha

# Python bytecode from running tools/*.py
__pycache__/

# Local NEEDLE and bead runtime state
.needle-predispatch-sha
.beads/events.jsonl
.beads/heartbeats.jsonl
.beads/diagnostics/
.beads/logs/
.beads/traces/
.beads/receipts/
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal
.beads/*.db.backup.*
.beads/*.lock
.beads/*.tmp
.beads/*.temp
.beads/*.journal
.br_recovery/
