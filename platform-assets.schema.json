{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.ardenone.com/jedarden/brand-kit/platform-assets.schema.json",
  "title": "Brand Kit Platform Assets",
  "description": "The generated, upload-ready assets indexed by platform role.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "sizes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/size"
          },
          "uniqueItems": true
        }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "role",
        "path",
        "dimensions",
        "source"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "profile_picture",
            "banner",
            "favicon"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\s]+$"
        },
        "dimensions": {
          "$ref": "#/$defs/dimensions"
        },
        "source": {
          "type": "string",
          "enum": [
            "source/logo.svg",
            "source/hero.png"
          ]
        }
      }
    }
  }
}
