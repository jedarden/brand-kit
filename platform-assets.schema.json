{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.ardenone.com/jedarden/brand-kit/platform-assets.schema.json",
  "title": "Brand Kit Platform Assets",
  "description": "Version 4 of the generated asset index. Every platform role and dimension has cited evidence classified as an upload minimum, recommendation, specified size, within-limits choice, or project choice; source fingerprints detect content changes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "upload_constraints",
    "platform_requirements",
    "assets",
    "requirement_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "upload_constraints": {
      "$ref": "#/$defs/upload_constraints"
    },
    "platform_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/platform_requirement"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "requirement_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/requirement_evidence"
      }
    }
  },
  "$defs": {
    "upload_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formats",
        "color_mode",
        "alpha",
        "max_file_size_bytes"
      ],
      "properties": {
        "formats": {
          "const": ["PNG", "ICO"]
        },
        "color_mode": {
          "const": "RGB"
        },
        "alpha": {
          "const": "forbidden"
        },
        "max_file_size_bytes": {
          "const": 5242880
        }
      }
    },
    "platform_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "source_url",
        "last_verified",
        "source_content_sha256"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "enum": [
            "X / Twitter",
            "LinkedIn (personal)",
            "LinkedIn (company)",
            "GitHub",
            "Instagram",
            "Threads",
            "Facebook",
            "YouTube",
            "TikTok",
            "Mastodon",
            "Bluesky",
            "Discord",
            "Web / Open Graph"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "description": "Absolute HTTPS URL without userinfo or whitespace.",
          "pattern": "^https://[^\\s/@?#]+(?:[/?#][^\\s]*)?$"
        },
        "last_verified": {
          "type": "string",
          "format": "date",
          "description": "A real calendar date in YYYY-MM-DD form; CI also rejects future dates.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "source_content_sha256": {
          "description": "SHA-256 of normalized visible source text; null only when the source blocks automated retrieval.",
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "sizes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/size"
          },
          "uniqueItems": true
        }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "role",
        "path",
        "dimensions",
        "source"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "enum": [
            "X / Twitter",
            "LinkedIn (personal)",
            "LinkedIn (company)",
            "GitHub",
            "Instagram",
            "Threads",
            "Facebook",
            "YouTube",
            "TikTok",
            "Mastodon",
            "Bluesky",
            "Discord",
            "Web / Open Graph"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "profile_picture",
            "banner",
            "favicon"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "A repository-relative POSIX path with no whitespace, absolute prefix, or parent-directory segment.",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\s]+$"
        },
        "dimensions": {
          "$ref": "#/$defs/dimensions"
        },
        "source": {
          "type": "string",
          "enum": [
            "source/logo.svg",
            "source/hero.png"
          ]
        }
      }
    },
    "requirement_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "role",
        "dimensions",
        "classification",
        "source_url",
        "source_content_sha256",
        "evidence"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "X / Twitter", "LinkedIn (personal)", "LinkedIn (company)", "GitHub",
            "Instagram", "Threads", "Facebook", "YouTube", "TikTok", "Mastodon",
            "Bluesky", "Discord", "Web / Open Graph"
          ]
        },
        "role": {"type": "string", "enum": ["profile_picture", "banner", "favicon"]},
        "dimensions": {"$ref": "#/$defs/size"},
        "classification": {
          "type": "string",
          "enum": ["upload_minimum", "recommendation", "specified_size", "within_limits", "project_choice"]
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s/@?#]+(?:[/?#][^\\s]*)?$"
        },
        "source_content_sha256": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
